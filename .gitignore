# ============================================================
# QuantPick .gitignore
# 目标:仓库只保留源码与文档;二进制、运行数据、证书一律不入库
# ============================================================

# ---------- 运行时数据(会自动生成) ----------
.cache/
logs/
*.log

# ---------- 测试运行产物 ----------
_smoke/_data/
_smoke/_out_*.txt

# ---------- 证书与密钥(绝不入库) ----------
cert/
*.pem
*.key
*.pfx
*.p12
*.crt
*.jks
*.keystore

# ---------- 桌面版构建产物 ----------
dist-desktop/
desktop.zip
stub.exe
node.exe
node.zip
QuantPick桌面版.exe

# ---------- 通用二进制(源码仓库不放可执行文件) ----------
*.exe
*.dll
*.msi
*.dmg
*.AppImage

# ---------- 依赖与临时目录 ----------
node_modules/
_deploy_stage/
*.tmp

# ---------- 操作系统 / 编辑器 ----------
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
